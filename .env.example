# Copy this file to .env (optional; defaults work)
PORT=3000
JWT_SECRET=change-me-for-the-demo

# Optional: a TURN relay lets video work between devices on different networks (for example phone on mobile data).
# Get free credentials from a TURN provider and fill these in, then restart the app.
TURN_URL=turn:your-turn-host:80,turns:your-turn-host:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=


SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. The server refuses to start if this is missing, short (under 32 chars) or a placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=